# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# OpenAI-compatible transcription server.
# With docker compose this is set automatically; for bare-metal point it at
# your speaches / faster-whisper-server instance.
STT_URL=http://localhost:8000

# Whisper model served by the STT server. small is a good CPU default;
# use medium or large-v3 if you have a GPU.
STT_MODEL=Systran/faster-whisper-small

# Optional language hint (ISO 639-1, e.g. en / he). Unset = auto-detect.
#STT_LANGUAGE=en

# Tuning (milliseconds)
#SILENCE_MS=1200        # pause length that ends a speech segment
#MIN_SPEECH_MS=600      # discard shorter blips as noise
#MAX_SEGMENT_MS=45000   # flush continuous speech in chunks this long

# Where assignments.json is stored
#DATA_DIR=./data
