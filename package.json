{
  "name": "discord-vc-scribe",
  "version": "0.1.0",
  "description": "Discord voice transcription with configurable room destinations and optional person-following priority.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "DISCORD_TOKEN=test-token node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomerh2001/discord-vc-scribe.git"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "libsodium-wrappers": "^0.7.15",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
